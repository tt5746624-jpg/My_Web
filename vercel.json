{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/drone_generator.php",
      "dest": "/drone_generator.php"
    },
    {
      "src": "/(.*)",
      "dest": "/index.php"
    }
  ]
}
